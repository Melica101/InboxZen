# Backend (Spring Boot). Gemini key optional: without it the AI endpoints run in "demo" mode.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# >= 32 bytes. Blank = random key per start (logins don't survive a restart).
JWT_SECRET=
# Comma separated frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
# Optional: DB_URL (default file H2 ./data/inboxzen), DB_USER, DB_PASSWORD, APP_ZONE (default Europe/Rome)

# Legacy Node mock server (frontend/server.mjs)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
